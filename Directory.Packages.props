<Project>

  <!--
    Central package management. Project files must not declare package versions.
    See docs/adr/ADR-0003-monorepo-solution-and-project-organisation.md.

    Add one PackageVersion entry here for each package a project requires, with an
    exact version. Floating versions are not permitted.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Persistence. EF Core and the PostgreSQL provider move together: the provider is
    pinned to the major line that matches EF Core, and both are bumped in one change
    with a restore, build, migration diff and test run as the evidence.
    See docs/adr/ADR-0004-database-per-service-and-tenant-isolation.md.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    The xunit v2 test toolchain. Versions are pinned exactly and bumped
    deliberately, with a full restore, build and test run as the evidence.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
