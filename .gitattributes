# Normalise line endings in the repository so Windows and Linux produce identical
# working trees and the dotnet format gate behaves the same everywhere.
# This setting takes precedence over core.autocrlf.
* text=auto eol=lf

*.sln text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
