# Development-only infrastructure configuration for deploy/compose.
#
# Copy to .env, or let scripts/infra.ps1 -Action up generate it for you.
# .env is git-ignored. Never put a production credential in this file.
#
# Every value marked __GENERATE__ is replaced with a random, development-only value.
# Passwords are generated from a restricted alphabet so they can be passed safely to
# the PostgreSQL initialisation script.

# Host ports. Change a value when a port is already in use on this machine, for
# example when a locally installed PostgreSQL service already owns 5432:
#   CB_POSTGRES_PORT=15432
# or a locally installed Redis already owns 6379:
#   CB_CACHE_PORT=16379
CB_POSTGRES_PORT=5432
CB_BROKER_PORT=9092
CB_CACHE_PORT=6379
CB_OTLP_GRPC_PORT=4317
CB_OTLP_HTTP_PORT=4318

POSTGRES_ADMIN_PASSWORD=__GENERATE__

CORELEDGER_APP_PASSWORD=__GENERATE__
CORELEDGER_MIGRATOR_PASSWORD=__GENERATE__

CUSTOMERONBOARDING_APP_PASSWORD=__GENERATE__
CUSTOMERONBOARDING_MIGRATOR_PASSWORD=__GENERATE__

IDENTITYACCESS_APP_PASSWORD=__GENERATE__
IDENTITYACCESS_MIGRATOR_PASSWORD=__GENERATE__

PAYMENTSVTU_APP_PASSWORD=__GENERATE__
PAYMENTSVTU_MIGRATOR_PASSWORD=__GENERATE__

CHANNELSENGAGEMENT_APP_PASSWORD=__GENERATE__
CHANNELSENGAGEMENT_MIGRATOR_PASSWORD=__GENERATE__

OPERATIONSWORKFLOW_APP_PASSWORD=__GENERATE__
OPERATIONSWORKFLOW_MIGRATOR_PASSWORD=__GENERATE__

RISKREPORTING_APP_PASSWORD=__GENERATE__
RISKREPORTING_MIGRATOR_PASSWORD=__GENERATE__

INTEGRATIONHUB_APP_PASSWORD=__GENERATE__
INTEGRATIONHUB_MIGRATOR_PASSWORD=__GENERATE__

AUDITRECONCILIATION_APP_PASSWORD=__GENERATE__
AUDITRECONCILIATION_MIGRATOR_PASSWORD=__GENERATE__
